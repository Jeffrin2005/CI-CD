
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }


    stages {
        stage('Install Frontend Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=CI-CD \
                            -Dsonar.sources=frontend/src \
                            -Dsonar.exclusions=frontend/node_modules/**,frontend/dist/**
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline stopped: Quality Gate status is ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    trivy fs \
                    --scanners vuln,secret,misconfig \
                    --format json \
                    -o trivy-report.json .
                '''
            }

            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // Build frontend and backend Docker images
        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build \
                        -t jeffrinjojo/frontend:${BUILD_NUMBER} \
                        -t jeffrinjojo/frontend:latest ./frontend

                    docker build \
                        -t jeffrinjojo/backend:${BUILD_NUMBER} \
                        -t jeffrinjojo/backend:latest ./backend
                '''
            }
        }

        // Push images to Docker Hub
        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            -u "$DOCKERHUB_USERNAME" --password-stdin

                        docker push jeffrinjojo/frontend:${BUILD_NUMBER}
                        docker push jeffrinjojo/frontend:latest

                        docker push jeffrinjojo/backend:${BUILD_NUMBER}
                        docker push jeffrinjojo/backend:latest

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend build, SonarQube, Trivy and Docker image push completed successfully!'
        }

        failure {
            echo 'Pipeline failed! Check the console output.'
        }
    }
}
